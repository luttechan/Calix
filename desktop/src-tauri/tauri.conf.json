{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calix",
  "version": "1.5.92",
  "identifier": "io.github.luttechan.calix",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Calix",
        "width": 1440,
        "height": 960,
        "minWidth": 820,
        "minHeight": 640,
        "decorations": false,
        "alwaysOnTop": true,
        "backgroundColor": "#17141c",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../../asset/icons/calix.ico"
    ],
    "externalBin": [
      "binaries/calix-engine"
    ],
    "resources": {
      "engine/_internal/": "_internal/"
    },
    "publisher": "Lutein Studio",
    "shortDescription": "일정 관리",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "template": "../installer/installer.nsi"
      }
    },
    "copyright": "Copyright 2026 JINYEONG OH, Lutein Studio"
  }
}
